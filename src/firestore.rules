rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    // saját profil: csak a gazdája látja és írja
    match /data/users/{uid}/profile {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }
    // nyilvános névjegy (név, barátkód, győzelmek, cserélhető lapok): bárki olvashatja, csak a gazdája írja
    match /pub/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;
    }
    // barátságok és cserék: csak az érintett két játékos
    match /friends/{id} {
      allow read, update, delete: if signedIn() && request.auth.uid in resource.data.parts;
      allow create: if signedIn() && request.auth.uid in request.resource.data.parts;
    }
    match /trades/{id} {
      allow read, update, delete: if signedIn() && request.auth.uid in resource.data.parts;
      allow create: if signedIn() && request.auth.uid in request.resource.data.parts;
    }
    // PvP-meccsek: bejelentkezett játékosok
    match /pvp/{id} {
      allow read, write: if signedIn();
      match /mull/{side} {
        allow read, write: if signedIn();
      }
    }
  }
}
